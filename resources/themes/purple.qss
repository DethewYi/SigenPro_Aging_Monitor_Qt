/*
 * SigenPro Aging Monitor — Royal Purple Theme
 * Deep purple accent for premium / monitoring dashboard feel
 */

QWidget {
    background-color: #1a1025;
    color: #e1d0e8;
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
    font-size: 13px;
}

QMainWindow { background-color: #1a1025; }
QMainWindow::separator { background-color: #3c1a6e; width: 1px; height: 1px; }
QStackedWidget { background-color: #1a1025; border: none; }

QLabel {
    background-color: transparent; color: #e1d0e8; border: none; padding: 1px;
}
QLabel[class="title"] { font-size: 18px; font-weight: bold; color: #ede7f6; }
QLabel[class="subtitle"] { font-size: 14px; color: #9575cd; }
QLabel[class="value"] { font-size: 24px; font-weight: bold; color: #ce93d8; }
QLabel[class="unit"] { font-size: 12px; color: #9575cd; }
QLabel[class="alarm"] { font-size: 13px; color: #ef9a9a; font-weight: bold; }
QLabel[class="success"] { font-size: 13px; color: #a5d6a7; font-weight: bold; }

QPushButton {
    background-color: #2d1a3e; color: #e1d0e8; border: 1px solid #7b1fa2;
    border-radius: 6px; padding: 6px 16px; min-height: 22px; font-weight: 500;
}
QPushButton:hover { background-color: #7b1fa2; border-color: #ce93d8; color: #ede7f6; }
QPushButton:pressed { background-color: #9575cd; border-color: #ce93d8; }
QPushButton:disabled { background-color: #2d1a3e; color: #5c4f72; border-color: #7b1fa2; }
QPushButton:checked { background-color: #ce93d8; color: #1a1025; border-color: #ce93d8; }

QPushButton[style="primary"] { background-color: #7b1fa2; color: #ffffff; border-color: #7b1fa2; font-weight: bold; }
QPushButton[style="primary"]:hover { background-color: #9575cd; border-color: #9575cd; }
QPushButton[style="primary"]:pressed { background-color: #7b1fa2; }

QPushButton[style="danger"] { background-color: #ef5350; color: #ffffff; border-color: #ef5350; }
QPushButton[style="danger"]:hover { background-color: #f44336; border-color: #f44336; }

QPushButton[style="success"] { background-color: #66bb6a; color: #ffffff; border-color: #66bb6a; }
QPushButton[style="success"]:hover { background-color: #81c784; border-color: #81c784; }

QPushButton[style="warning"] { background-color: #ff9800; color: #ffffff; border-color: #ff9800; }
QPushButton[style="warning"]:hover { background-color: #ffb74d; border-color: #ffb74d; }

QLineEdit {
    background-color: #2d1a3e; color: #e1d0e8; border: 1px solid #7b1fa2;
    border-radius: 6px; padding: 5px 10px;
    selection-background-color: #ce93d8; selection-color: #1a1025;
}
QLineEdit:hover { border-color: #5c4f72; }
QLineEdit:focus { border-color: #ce93d8; }
QLineEdit:disabled { background-color: #1a1025; color: #5c4f72; border-color: #2d1a3e; }
QLineEdit:read-only { background-color: #1a1025; color: #9575cd; border-color: #7b1fa2; }

QComboBox {
    background-color: #2d1a3e; color: #e1d0e8; border: 1px solid #7b1fa2;
    border-radius: 6px; padding: 5px 10px; min-width: 80px;
}
QComboBox:hover { border-color: #5c4f72; }
QComboBox:focus { border-color: #ce93d8; }
QComboBox::drop-down {
    subcontrol-origin: padding; subcontrol-position: top right; width: 24px;
    border-left: 1px solid #7b1fa2; border-top-right-radius: 6px; border-bottom-right-radius: 6px;
}
QComboBox::down-arrow {
    image: none; border: none; width: 0; height: 0;
    border-left: 4px solid transparent; border-right: 4px solid transparent;
    border-top: 6px solid #e1d0e8; margin-right: 8px;
}
QComboBox QAbstractItemView {
    background-color: #2d1a3e; color: #e1d0e8; border: 1px solid #7b1fa2;
    border-radius: 6px; selection-background-color: #ce93d8; selection-color: #1a1025; outline: none; padding: 4px;
}
QComboBox QAbstractItemView::item { min-height: 26px; padding: 4px 8px; border-radius: 4px; }
QComboBox QAbstractItemView::item:hover { background-color: #7b1fa2; }
QComboBox QAbstractItemView::item:selected { background-color: #ce93d8; color: #1a1025; }

QSpinBox, QDoubleSpinBox {
    background-color: #2d1a3e; color: #e1d0e8; border: 1px solid #7b1fa2; border-radius: 6px; padding: 5px 10px;
}
QSpinBox:hover, QDoubleSpinBox:hover { border-color: #5c4f72; }
QSpinBox:focus, QDoubleSpinBox:focus { border-color: #ce93d8; }
QSpinBox::up-button, QSpinBox::down-button, QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background-color: #7b1fa2; border: none; width: 20px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover, QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #9575cd;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: none; border: none; width: 0; height: 0;
    border-left: 4px solid transparent; border-right: 4px solid transparent;
    border-bottom: 5px solid #e1d0e8;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: none; border: none; width: 0; height: 0;
    border-left: 4px solid transparent; border-right: 4px solid transparent;
    border-top: 5px solid #e1d0e8;
}

QTableWidget, QTableView {
    background-color: #1a1025; alternate-background-color: #140b15; color: #e1d0e8;
    border: 1px solid #7b1fa2; border-radius: 6px; gridline-color: #2d1a3e;
    selection-background-color: #7b1fa2; selection-color: #e1d0e8; outline: none;
}
QTableWidget::item, QTableView::item { padding: 4px 8px; border-bottom: 1px solid #2d1a3e; }
QTableWidget::item:hover, QTableView::item:hover { background-color: #2d1a3e; }
QHeaderView::section {
    background-color: #2d1a3e; color: #e1d0e8; font-weight: 600; border: none;
    border-right: 1px solid #7b1fa2; border-bottom: 2px solid #ce93d8; padding: 6px 10px;
}
QHeaderView::section:hover { background-color: #7b1fa2; }

QScrollBar:vertical {
    background-color: #1a1025; width: 10px; border: none; margin: 0;
}
QScrollBar::handle:vertical { background-color: #7b1fa2; min-height: 30px; border-radius: 5px; margin: 2px; }
QScrollBar::handle:vertical:hover { background-color: #9575cd; }
QScrollBar::handle:vertical:pressed { background-color: #ce93d8; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; border: none; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }

QScrollBar:horizontal {
    background-color: #1a1025; height: 10px; border: none; margin: 0;
}
QScrollBar::handle:horizontal { background-color: #7b1fa2; min-width: 30px; border-radius: 5px; margin: 2px; }
QScrollBar::handle:horizontal:hover { background-color: #9575cd; }
QScrollBar::handle:horizontal:pressed { background-color: #ce93d8; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; border: none; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: none; }

QStatusBar {
    background-color: #140b15; color: #9575cd; border-top: 1px solid #2d1a3e; font-size: 12px; padding: 2px 8px;
}
QStatusBar::item { border: none; }

QMenuBar {
    background-color: #140b15; color: #e1d0e8; border-bottom: 1px solid #2d1a3e; padding: 2px;
}
QMenuBar::item { background-color: transparent; padding: 4px 12px; border-radius: 4px; }
QMenuBar::item:hover { background-color: #2d1a3e; }
QMenuBar::item:selected { background-color: #7b1fa2; }
QMenuBar::item:pressed { background-color: #7b1fa2; }

QMenu {
    background-color: #2d1a3e; color: #e1d0e8; border: 1px solid #7b1fa2;
    border-radius: 6px; padding: 4px;
}
QMenu::item { padding: 6px 30px 6px 16px; border-radius: 4px; }
QMenu::item:hover { background-color: #7b1fa2; }
QMenu::item:selected { background-color: #ce93d8; color: #1a1025; }
QMenu::separator { height: 1px; background-color: #7b1fa2; margin: 4px 8px; }
QMenu::indicator { width: 16px; height: 16px; margin-left: 4px; }

QGroupBox {
    background-color: #1a1025; border: 1px solid #7b1fa2; border-radius: 8px;
    margin-top: 12px; padding: 12px 8px 8px 8px; font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin; subcontrol-position: top left; padding: 0 8px; color: #ce93d8;
}

QTabWidget::pane {
    background-color: #1a1025; border: 1px solid #7b1fa2; border-radius: 6px; top: -1px;
}
QTabBar::tab {
    background-color: #2d1a3e; color: #9575cd; border: 1px solid #7b1fa2;
    border-bottom: none; border-top-left-radius: 6px; border-top-right-radius: 6px;
    padding: 6px 16px; margin-right: 2px;
}
QTabBar::tab:hover { background-color: #7b1fa2; color: #e1d0e8; }
QTabBar::tab:selected { background-color: #1a1025; color: #ce93d8; border-bottom: 2px solid #ce93d8; }

QProgressBar {
    background-color: #2d1a3e; border: 1px solid #7b1fa2; border-radius: 6px;
    text-align: center; color: #e1d0e8; min-height: 18px; font-weight: bold;
}
QProgressBar::chunk { background-color: #ce93d8; border-radius: 5px; }

QCheckBox { color: #e1d0e8; spacing: 8px; }
QCheckBox::indicator {
    width: 18px; height: 18px; border: 2px solid #7b1fa2; border-radius: 4px; background-color: #2d1a3e;
}
QCheckBox::indicator:hover { border-color: #ce93d8; }
QCheckBox::indicator:checked { background-color: #ce93d8; border-color: #ce93d8; image: none; }

QRadioButton { color: #e1d0e8; spacing: 8px; }
QRadioButton::indicator {
    width: 18px; height: 18px; border: 2px solid #7b1fa2; border-radius: 10px; background-color: #2d1a3e;
}
QRadioButton::indicator:hover { border-color: #ce93d8; }
QRadioButton::indicator:checked { border-color: #ce93d8; background-color: #2d1a3e; }

QSlider::groove:horizontal { background-color: #7b1fa2; height: 6px; border-radius: 3px; }
QSlider::handle:horizontal { background-color: #ce93d8; width: 16px; height: 16px; margin: -5px 0; border-radius: 8px; }
QSlider::handle:horizontal:hover { background-color: #b388ff; }
QSlider::sub-page:horizontal { background-color: #ce93d8; border-radius: 3px; }

QToolTip {
    background-color: #2d1a3e; color: #e1d0e8; border: 1px solid #7b1fa2;
    border-radius: 4px; padding: 4px 8px;
}

QFrame[class="card"] { background-color: #2d1a3e; border: 1px solid #7b1fa2; border-radius: 8px; padding: 12px; }
QFrame[class="data-card"] { background-color: #2d1a3e; border: 1px solid #7b1fa2; border-radius: 8px; padding: 16px; }
QFrame[class="data-card"]:hover { border-color: #5c4f72; }

QTextEdit, QPlainTextEdit {
    background-color: #1a1025; color: #e1d0e8; border: 1px solid #7b1fa2;
    border-radius: 6px; selection-background-color: #ce93d8; selection-color: #1a1025; padding: 4px;
}

QListWidget {
    background-color: #1a1025; alternate-background-color: #140b15; color: #e1d0e8;
    border: 1px solid #7b1fa2; border-radius: 6px; outline: none; padding: 2px;
}
QListWidget::item { padding: 6px 8px; border-radius: 4px; }
QListWidget::item:hover { background-color: #2d1a3e; }
QListWidget::item:selected { background-color: #7b1fa2; color: #ce93d8; }

QTreeWidget {
    background-color: #1a1025; alternate-background-color: #140b15; color: #e1d0e8;
    border: 1px solid #7b1fa2; border-radius: 6px; outline: none;
}
QTreeWidget::item { padding: 4px 4px; border-bottom: 1px solid #2d1a3e; }
QTreeWidget::item:hover { background-color: #2d1a3e; }
QTreeWidget::item:selected { background-color: #7b1fa2; color: #ce93d8; }

QDialog { background-color: #1a1025; color: #e1d0e8; }

QSplitter::handle { background-color: #7b1fa2; }
QSplitter::handle:horizontal { width: 2px; }
QSplitter::handle:vertical { height: 2px; }
QSplitter::handle:hover { background-color: #ce93d8; }

QDockWidget { color: #e1d0e8; }
QDockWidget::title { background-color: #140b15; color: #e1d0e8; border-bottom: 1px solid #2d1a3e; padding: 6px; }

QDateEdit, QTimeEdit, QDateTimeEdit {
    background-color: #2d1a3e; color: #e1d0e8; border: 1px solid #7b1fa2;
    border-radius: 6px; padding: 5px 10px;
}
QDateEdit:hover, QTimeEdit:hover, QDateTimeEdit:hover { border-color: #5c4f72; }
QDateEdit:focus, QTimeEdit:focus, QDateTimeEdit:focus { border-color: #ce93d8; }
QCalendarWidget { background-color: #1a1025; border: 1px solid #7b1fa2; border-radius: 6px; }
QCalendarWidget QToolButton { color: #e1d0e8; background-color: #2d1a3e; border-radius: 4px; padding: 4px; }
QCalendarWidget QMenu { background-color: #2d1a3e; color: #e1d0e8; }
QCalendarWidget QAbstractItemView { background-color: #1a1025; color: #e1d0e8; selection-background-color: #ce93d8; selection-color: #1a1025; }

QPushButton[class="nav-button"] {
    background-color: transparent; color: #9575cd; border: none; border-radius: 6px;
    padding: 10px 16px; text-align: left; font-size: 13px; font-weight: 500;
}
QPushButton[class="nav-button"]:hover { background-color: #2d1a3e; color: #e1d0e8; }
QPushButton[class="nav-button"]:checked { background-color: #7b1fa2; color: #ce93d8; border-left: 3px solid #ce93d8; }
QPushButton[class="nav-button"]:pressed { background-color: #7b1fa2; }
