/*
 * SigenPro Aging Monitor — Light Theme
 */

/* ── Global / Base ────────────────────────────────────────── */
QWidget {
    background-color: #ffffff;
    color: #333333;
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
    font-size: 13px;
}

/* ── Main Window ──────────────────────────────────────────── */
QMainWindow {
    background-color: #ffffff;
}

QMainWindow::separator {
    background-color: #d0d0d0;
    width: 1px;
    height: 1px;
}

/* ── Stacked Widget ───────────────────────────────────────── */
QStackedWidget {
    background-color: #ffffff;
    border: none;
}

/* ── Labels ───────────────────────────────────────────────── */
QLabel {
    background-color: transparent;
    color: #333333;
    border: none;
    padding: 1px;
}

QLabel[class="title"] {
    font-size: 18px;
    font-weight: bold;
    color: #1a1a1a;
}

QLabel[class="subtitle"] {
    font-size: 14px;
    color: #666666;
}

QLabel[class="value"] {
    font-size: 24px;
    font-weight: bold;
    color: #4a90d9;
}

QLabel[class="unit"] {
    font-size: 12px;
    color: #888888;
}

QLabel[class="alarm"] {
    font-size: 13px;
    color: #d9534f;
    font-weight: bold;
}

QLabel[class="success"] {
    font-size: 13px;
    color: #5cb85c;
    font-weight: bold;
}

/* ── Push Button ──────────────────────────────────────────── */
QPushButton {
    background-color: #f5f5f5;
    color: #333333;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 6px 16px;
    min-height: 22px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #e8e8e8;
    border-color: #4a90d9;
    color: #333333;
}

QPushButton:pressed {
    background-color: #d0d0d0;
    border-color: #4a90d9;
}

QPushButton:disabled {
    background-color: #f5f5f5;
    color: #b0b0b0;
    border-color: #e0e0e0;
}

QPushButton:checked {
    background-color: #4a90d9;
    color: #ffffff;
    border-color: #4a90d9;
}

QPushButton[style="primary"] {
    background-color: #4a90d9;
    color: #ffffff;
    border-color: #4a90d9;
    font-weight: bold;
}

QPushButton[style="primary"]:hover {
    background-color: #357abd;
    border-color: #357abd;
}

QPushButton[style="primary"]:pressed {
    background-color: #4a90d9;
}

QPushButton[style="danger"] {
    background-color: #d9534f;
    color: #ffffff;
    border-color: #d9534f;
}

QPushButton[style="danger"]:hover {
    background-color: #c9302c;
    border-color: #c9302c;
}

QPushButton[style="success"] {
    background-color: #5cb85c;
    color: #ffffff;
    border-color: #5cb85c;
}

QPushButton[style="success"]:hover {
    background-color: #449d44;
    border-color: #449d44;
}

QPushButton[style="warning"] {
    background-color: #f0ad4e;
    color: #ffffff;
    border-color: #f0ad4e;
}

QPushButton[style="warning"]:hover {
    background-color: #ec971f;
    border-color: #ec971f;
}

/* ── Line Edit ────────────────────────────────────────────── */
QLineEdit {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 5px 10px;
    selection-background-color: #4a90d9;
    selection-color: #ffffff;
}

QLineEdit:hover {
    border-color: #b0b0b0;
}

QLineEdit:focus {
    border-color: #4a90d9;
}

QLineEdit:disabled {
    background-color: #f5f5f5;
    color: #b0b0b0;
    border-color: #e0e0e0;
}

QLineEdit:read-only {
    background-color: #f5f5f5;
    color: #666666;
    border-color: #d0d0d0;
}

/* ── Combo Box ────────────────────────────────────────────── */
QComboBox {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 5px 10px;
    min-width: 80px;
}

QComboBox:hover {
    border-color: #b0b0b0;
}

QComboBox:focus {
    border-color: #4a90d9;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #d0d0d0;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QComboBox::down-arrow {
    image: none;
    border: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid #333333;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    selection-background-color: #4a90d9;
    selection-color: #ffffff;
    outline: none;
    padding: 4px;
}

QComboBox QAbstractItemView::item {
    min-height: 26px;
    padding: 4px 8px;
    border-radius: 4px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #f0f0f0;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #4a90d9;
    color: #ffffff;
}

/* ── Spin Box ─────────────────────────────────────────────── */
QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 5px 10px;
}

QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #b0b0b0;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #4a90d9;
}

QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background-color: #f5f5f5;
    border: none;
    width: 20px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #e8e8e8;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: none;
    border: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #333333;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: none;
    border: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #333333;
}

/* ── Table Widget ─────────────────────────────────────────── */
QTableWidget, QTableView {
    background-color: #ffffff;
    alternate-background-color: #f8f8f8;
    color: #333333;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    gridline-color: #e8e8e8;
    selection-background-color: #e8f0fe;
    selection-color: #333333;
    outline: none;
}

QTableWidget::item, QTableView::item {
    padding: 4px 8px;
    border-bottom: 1px solid #f0f0f0;
}

QTableWidget::item:hover, QTableView::item:hover {
    background-color: #f5f5f5;
}

QHeaderView::section {
    background-color: #f5f5f5;
    color: #333333;
    font-weight: 600;
    border: none;
    border-right: 1px solid #e0e0e0;
    border-bottom: 2px solid #4a90d9;
    padding: 6px 10px;
}

QHeaderView::section:hover {
    background-color: #e8e8e8;
}

/* ── Scroll Bar ───────────────────────────────────────────── */
QScrollBar:vertical {
    background-color: #f5f5f5;
    width: 10px;
    border: none;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #c0c0c0;
    min-height: 30px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #a0a0a0;
}

QScrollBar::handle:vertical:pressed {
    background-color: #4a90d9;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: #f5f5f5;
    height: 10px;
    border: none;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #c0c0c0;
    min-width: 30px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #a0a0a0;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #4a90d9;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
    border: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* ── Status Bar ───────────────────────────────────────────── */
QStatusBar {
    background-color: #f5f5f5;
    color: #666666;
    border-top: 1px solid #d0d0d0;
    font-size: 12px;
    padding: 2px 8px;
}

QStatusBar::item {
    border: none;
}

/* ── Menu Bar ─────────────────────────────────────────────── */
QMenuBar {
    background-color: #f5f5f5;
    color: #333333;
    border-bottom: 1px solid #d0d0d0;
    padding: 2px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 12px;
    border-radius: 4px;
}

QMenuBar::item:hover {
    background-color: #e8e8e8;
}

QMenuBar::item:selected {
    background-color: #e0e0e0;
}

QMenuBar::item:pressed {
    background-color: #e0e0e0;
}

/* ── Menu ─────────────────────────────────────────────────── */
QMenu {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 30px 6px 16px;
    border-radius: 4px;
}

QMenu::item:hover {
    background-color: #f0f0f0;
}

QMenu::item:selected {
    background-color: #4a90d9;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #e0e0e0;
    margin: 4px 8px;
}

QMenu::indicator {
    width: 16px;
    height: 16px;
    margin-left: 4px;
}

/* ── Group Box ────────────────────────────────────────────── */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 8px;
    margin-top: 12px;
    padding: 12px 8px 8px 8px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #4a90d9;
}

/* ── Tab Widget ───────────────────────────────────────────── */
QTabWidget::pane {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    top: -1px;
}

QTabBar::tab {
    background-color: #f5f5f5;
    color: #666666;
    border: 1px solid #d0d0d0;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 6px 16px;
    margin-right: 2px;
}

QTabBar::tab:hover {
    background-color: #e8e8e8;
    color: #333333;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #4a90d9;
    border-bottom: 2px solid #4a90d9;
}

/* ── Progress Bar ─────────────────────────────────────────── */
QProgressBar {
    background-color: #f5f5f5;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    text-align: center;
    color: #333333;
    min-height: 18px;
    font-weight: bold;
}

QProgressBar::chunk {
    background-color: #4a90d9;
    border-radius: 5px;
}

/* ── Check Box ────────────────────────────────────────────── */
QCheckBox {
    color: #333333;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #b0b0b0;
    border-radius: 4px;
    background-color: #ffffff;
}

QCheckBox::indicator:hover {
    border-color: #4a90d9;
}

QCheckBox::indicator:checked {
    background-color: #4a90d9;
    border-color: #4a90d9;
}

/* ── Radio Button ─────────────────────────────────────────── */
QRadioButton {
    color: #333333;
    spacing: 8px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #b0b0b0;
    border-radius: 10px;
    background-color: #ffffff;
}

QRadioButton::indicator:hover {
    border-color: #4a90d9;
}

QRadioButton::indicator:checked {
    border-color: #4a90d9;
    background-color: #ffffff;
}

/* ── Slider ───────────────────────────────────────────────── */
QSlider::groove:horizontal {
    background-color: #e0e0e0;
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: #4a90d9;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background-color: #357abd;
}

QSlider::sub-page:horizontal {
    background-color: #4a90d9;
    border-radius: 3px;
}

/* ── Tool Tip ─────────────────────────────────────────────── */
QToolTip {
    background-color: #333333;
    color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 4px 8px;
}

/* ── Frame / Card-like containers ─────────────────────────── */
QFrame[class="card"] {
    background-color: #f5f5f5;
    border: 1px solid #d0d0d0;
    border-radius: 8px;
    padding: 12px;
}

/* ── Text Edit / Plain Text Edit ──────────────────────────── */
QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    selection-background-color: #4a90d9;
    selection-color: #ffffff;
    padding: 4px;
}

/* ── List Widget ──────────────────────────────────────────── */
QListWidget {
    background-color: #ffffff;
    alternate-background-color: #f8f8f8;
    color: #333333;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    outline: none;
    padding: 2px;
}

QListWidget::item {
    padding: 6px 8px;
    border-radius: 4px;
}

QListWidget::item:hover {
    background-color: #f5f5f5;
}

QListWidget::item:selected {
    background-color: #e8f0fe;
    color: #4a90d9;
}

/* ── Tree Widget ──────────────────────────────────────────── */
QTreeWidget {
    background-color: #ffffff;
    alternate-background-color: #f8f8f8;
    color: #333333;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    outline: none;
}

QTreeWidget::item {
    padding: 4px 4px;
    border-bottom: 1px solid #f0f0f0;
}

QTreeWidget::item:hover {
    background-color: #f5f5f5;
}

QTreeWidget::item:selected {
    background-color: #e8f0fe;
    color: #4a90d9;
}

/* ── Dialog ───────────────────────────────────────────────── */
QDialog {
    background-color: #ffffff;
    color: #333333;
}

/* ── Splitter ─────────────────────────────────────────────── */
QSplitter::handle {
    background-color: #d0d0d0;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

QSplitter::handle:hover {
    background-color: #4a90d9;
}

/* ── Dock Widget ──────────────────────────────────────────── */
QDockWidget {
    color: #333333;
}

QDockWidget::title {
    background-color: #f5f5f5;
    color: #333333;
    border-bottom: 1px solid #d0d0d0;
    padding: 6px;
}

/* ── Date / Time Edit ─────────────────────────────────────── */
QDateEdit, QTimeEdit, QDateTimeEdit {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 5px 10px;
}

QDateEdit:hover, QTimeEdit:hover, QDateTimeEdit:hover {
    border-color: #b0b0b0;
}

QDateEdit:focus, QTimeEdit:focus, QDateTimeEdit:focus {
    border-color: #4a90d9;
}

QCalendarWidget {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
}

QCalendarWidget QToolButton {
    color: #333333;
    background-color: #f5f5f5;
    border-radius: 4px;
    padding: 4px;
}

QCalendarWidget QMenu {
    background-color: #ffffff;
    color: #333333;
}

QCalendarWidget QAbstractItemView {
    background-color: #ffffff;
    color: #333333;
    selection-background-color: #4a90d9;
    selection-color: #ffffff;
}

/* ── Sidebar navigation button style ──────────────────────── */
QPushButton[class="nav-button"] {
    background-color: transparent;
    color: #666666;
    border: none;
    border-radius: 6px;
    padding: 10px 16px;
    text-align: left;
    font-size: 13px;
    font-weight: 500;
}

QPushButton[class="nav-button"]:hover {
    background-color: #f0f0f0;
    color: #333333;
}

QPushButton[class="nav-button"]:checked {
    background-color: #e8f0fe;
    color: #4a90d9;
    border-left: 3px solid #4a90d9;
}

QPushButton[class="nav-button"]:pressed {
    background-color: #e0e0e0;
}

/* ── Alarm status indicators ──────────────────────────────── */
QLabel[class="alarm-indicator-ok"] {
    color: #5cb85c;
    font-weight: bold;
}

QLabel[class="alarm-indicator-warn"] {
    color: #f0ad4e;
    font-weight: bold;
}

QLabel[class="alarm-indicator-error"] {
    color: #d9534f;
    font-weight: bold;
}

/* ── Custom roles: value displays ─────────────────────────── */
QFrame[class="data-card"] {
    background-color: #f5f5f5;
    border: 1px solid #d0d0d0;
    border-radius: 8px;
    padding: 16px;
}

QFrame[class="data-card"]:hover {
    border-color: #b0b0b0;
}

/* ── Stats bar cards ──────────────────────────────────────── */
*[class="stat-online"], *[class="stat-offline"],
*[class="stat-alarm"], *[class="stat-testing"] {
    background-color: #f0f0f0;
    border-radius: 6px;
    padding: 8px 16px;
    border: none;
}
*[class="stat-online"]  { border-left: 4px solid #4a90d9; color: #4a90d9; }
*[class="stat-offline"] { border-left: 4px solid #999999; color: #999999; }
*[class="stat-alarm"]   { border-left: 4px solid #e53935; color: #e53935; }
*[class="stat-testing"] { border-left: 4px solid #43a047; color: #43a047; }

/* ── Device cards ──────────────────────────────────────────── */
DeviceCardWidget {
    background-color: #f0f0f0;
    border: 1px solid #d0d0d0;
    border-radius: 8px;
}
DeviceCardWidget:hover {
    background-color: #e0e0e0;
}

/* ── Device card labels ────────────────────────────────────── */
QLabel[class="subtitle"] { color: #666666; font-size: 11px; }
QLabel[class="params"]   { font-size: 11px; }
QLabel[class="phase-info"] { color: #2e7d32; font-size: 11px; font-weight: bold; }
